@PACKAGE_INIT@

# Firefly 的包配置。由 CMakeLists.txt 的 install(EXPORT) 生成 FireflyTargets.cmake，
# 这里只负责把依赖找回来，再把 target 定义包含进来。
#
# 可用 target：
#   firefly::firefly       Core + 默认后端（FIREFLY_WITH_NNG=ON 时为 NNG，否则内存）
#   firefly::firefly_core  Core + 内存后端，从不依赖 NNG
#   firefly::firefly_nng   仅 NNG 后端（仅在构建时 FIREFLY_WITH_NNG=ON 时存在）
#
# 注意：firefly::firefly 与 firefly::firefly_core 都包含 Core object，同时链接
# 会重复定义符号，只能选其一。

include(CMakeFindDependencyMacro)
find_dependency(protobuf CONFIG)
find_dependency(Threads)
if(@FIREFLY_CONFIG_WITH_NNG@)
  find_dependency(nng CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/FireflyTargets.cmake")

# 构建树里用 firefly::core / firefly::nng 命名，安装后是导出名；补上别名，
# 让同一份消费者 CMakeLists 在 add_subdirectory 与 find_package 两种接入下都成立。
if(TARGET firefly::firefly_core AND NOT TARGET firefly::core)
  add_library(firefly::core ALIAS firefly::firefly_core)
endif()
if(TARGET firefly::firefly_nng AND NOT TARGET firefly::nng)
  add_library(firefly::nng ALIAS firefly::firefly_nng)
endif()
